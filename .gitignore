# === 敏感数据（绝不进版本库） ===
# 真实数据库 —— 只保留 data/.gitkeep 占位，实际数据文件全部忽略
data/*
!data/.gitkeep
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# 环境变量 / 密钥 —— 严禁上传
.env
.env.*
*.key
*.pem
secrets.json

# 运维手册（含内网/端口/部署细节，私有，不公开）
部署运维手册.md
*运维手册*
*部署手册*

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
*.egg-info/
.pytest_cache/

# === 开发过程垃圾 ===
*.bak
*.backup
*.backup.*
*.orig
*.swp
*~

# === 系统 / 编辑器 ===
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sublime-*

# === 日志 ===
*.log
logs/
